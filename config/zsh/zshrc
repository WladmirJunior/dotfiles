# ─────────────────────────── SSH ───────────────────────────
alias sshx='TERM=xterm-256color ssh'

# Attach to the long-lived tmux session on a remote Mac. `ssh -t` forces a TTY
# (without it tmux exits with "not a terminal"), and `new-session -A` attaches
# when the session exists and creates it otherwise.
#
# On macOS the tmux SERVER carries the keychain security context and hands it to
# every child process. A server first spawned from a bare ssh session inherits
# no keychain access, so Claude Code under it fails with "Not logged in" even
# when the keychain is unlocked. Attaching to an existing server is always fine.
# So: only when this command would start the server itself do we unlock the
# keychain first, in the same ssh session, which makes the new server inherit a
# usable context. The unlock prompts on the remote TTY; the password is never
# passed as an argument (`security unlock-keychain -p` is documented insecure)
# and never stored here.
wssh() {
  local host="${1:-work-remote}" session="${2:-main}"

  if ssh "$host" 'tmux has-session 2>/dev/null'; then
    ssh "$host" -t "tmux new-session -A -s ${(q)session}"
    return
  fi

  print -u2 "No tmux server on $host: this will start one."
  print -u2 "Unlocking the login keychain first, so it inherits a usable context."
  # Both commands share one ssh session on purpose: the unlock must happen in
  # the same security context that goes on to spawn the tmux server.
  ssh "$host" -t "
    if security show-keychain-info ~/Library/Keychains/login.keychain-db >/dev/null 2>&1; then
      echo 'keychain already reachable; skipping unlock'
    else
      security unlock-keychain ~/Library/Keychains/login.keychain-db || {
        echo 'unlock failed: starting tmux anyway, but Claude Code will not log in' >&2
      }
    fi
    tmux new-session -A -s ${(q)session}"
}

# ─────────────────────────── History ───────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_FCNTL_LOCK
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
unsetopt HIST_BEEP

# ─────────────────────────── Keybindings ───────────────────────────
# Keymap is declared, not inferred. Left unset, zsh picks it from $EDITOR, and
# with EDITOR=nvim a nested shell lands in viins while a top-level login shell
# gets emacs: same config, two behaviours. Emacs is the shell standard here
# (Ctrl+A/E/K are used constantly, in and out of the terminal).
bindkey -e

# Word jumps. terminfo for xterm-ghostty only declares kLFT/kRIT (Shift), so
# nothing maps Ctrl+arrow or Alt+arrow and the tail of the escape sequence used
# to leak into the buffer as ";5D" / ";3C" text.
#   CSI 1;<mod><letter>, where mod is 2=Shift 3=Alt 5=Ctrl 6=Ctrl+Shift
_zle_wleft()  { REGION_ACTIVE=0; zle backward-word }
_zle_wright() { REGION_ACTIVE=0; zle forward-word }
_zle_left()   { REGION_ACTIVE=0; zle backward-char }
_zle_right()  { REGION_ACTIVE=0; zle forward-char }

# Shift+arrow grows the region, which zsh already renders (see zle_highlight
# further down), so selection behaves like a macOS text field.
_zle_sel_begin() { (( REGION_ACTIVE )) || { MARK=$CURSOR; REGION_ACTIVE=1; } }
_zle_sel_left()   { _zle_sel_begin; zle backward-char }
_zle_sel_right()  { _zle_sel_begin; zle forward-char }
_zle_sel_wleft()  { _zle_sel_begin; zle backward-word }
_zle_sel_wright() { _zle_sel_begin; zle forward-word }
_zle_sel_home()   { _zle_sel_begin; zle beginning-of-line }
_zle_sel_end()    { _zle_sel_begin; zle end-of-line }

# Typing or backspacing over a live selection replaces it.
_zle_insert() {
    if (( REGION_ACTIVE )); then REGION_ACTIVE=0; zle kill-region; fi
    zle .self-insert
}
_zle_backspace() {
    if (( REGION_ACTIVE )); then
        REGION_ACTIVE=0
        zle kill-region
    else
        zle .backward-delete-char
    fi
}

for _w in _zle_wleft _zle_wright _zle_left _zle_right \
          _zle_sel_left _zle_sel_right _zle_sel_wleft _zle_sel_wright \
          _zle_sel_home _zle_sel_end _zle_backspace; do
    zle -N $_w
done
unset _w
zle -N self-insert _zle_insert

bindkey '^[[1;5D' _zle_wleft      # Ctrl+Left
bindkey '^[[1;5C' _zle_wright     # Ctrl+Right
bindkey '^[[1;3D' _zle_wleft      # Alt/Option+Left
bindkey '^[[1;3C' _zle_wright     # Alt/Option+Right
bindkey '^[[D'    _zle_left
bindkey '^[[C'    _zle_right
bindkey '^[[1;2D' _zle_sel_left   # Shift+Left
bindkey '^[[1;2C' _zle_sel_right  # Shift+Right
bindkey '^[[1;4D' _zle_sel_wleft  # Shift+Alt+Left
bindkey '^[[1;4C' _zle_sel_wright # Shift+Alt+Right
bindkey '^[[1;6D' _zle_sel_wleft  # Ctrl+Shift+Left
bindkey '^[[1;6C' _zle_sel_wright # Ctrl+Shift+Right
bindkey '^[[1;2H' _zle_sel_home
bindkey '^[[1;2F' _zle_sel_end
# Cmd+Shift+arrow selects to the start/end of the line, matching macOS. Ghostty
# sends modifier 10 (Cmd+Shift) here; plain Cmd+arrow it already translates to
# ^A/^E itself, so that pair needs no binding. Measured with `cat -v`.
bindkey '^[[1;10D' _zle_sel_home
bindkey '^[[1;10C' _zle_sel_end

# Ctrl+Up/Down walk the history, the arrow equivalent of Ctrl+P / Ctrl+N.
# Plain Up/Down can't do this on a multi-line entry: there they move between
# the lines of the buffer, so reaching the previous command means walking to
# the edge first. These always change entry regardless of the cursor row.
bindkey '^[[1;5A' up-history
bindkey '^[[1;5B' down-history

bindkey '^?' _zle_backspace
bindkey '^H' _zle_backspace

sudo-command-line() {
    [[ -z $BUFFER ]] && zle up-history
    if [[ $BUFFER == sudo\ * ]]; then
        LBUFFER="${LBUFFER#sudo }"
    else
        LBUFFER="sudo $LBUFFER"
    fi
}
zle -N sudo-command-line
bindkey '\e\e' sudo-command-line

# ─────────────────────────── Completion & Plugins ───────────────────────────
# Custom completions must join fpath before compinit or they are never loaded.
fpath=(~/.dotfiles/config/zsh/completions $fpath)
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export FZF_DEFAULT_OPTS='--height 50% --layout=reverse --border --info=inline'
export FZF_CTRL_R_OPTS='--preview "echo {}" --preview-window=down:3:wrap'
export FZF_CTRL_T_OPTS='--preview "bat --color=always --style=numbers --line-range=:200 {} 2>/dev/null || cat {}"'
export FZF_ALT_C_OPTS='--preview "ls -la --color=always {} | head -50 2>/dev/null || ls -la {}"'
[ -f ~/.config/zsh-plugins/fzf-tab/fzf-tab.plugin.zsh ] && source ~/.config/zsh-plugins/fzf-tab/fzf-tab.plugin.zsh
[ -f ~/.config/zsh-plugins/zsh-you-should-use/you-should-use.plugin.zsh ] && source ~/.config/zsh-plugins/zsh-you-should-use/you-should-use.plugin.zsh
if command -v zoxide &>/dev/null; then
    if [[ ! -f ~/.zoxide.zsh ]] || [[ -n ~/.zoxide.zsh(#qN.mh+168) ]]; then
        zoxide init zsh > ~/.zoxide.zsh
    fi
    source ~/.zoxide.zsh
fi
[ -f ~/.config/zsh-plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh ] && source ~/.config/zsh-plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh

# Use the active Ghostty theme's selection-background as the bracketed-paste
# highlight color. Falls through silently when Ghostty is not installed.
_paste_highlight_init() {
  local config="${HOME}/.config/ghostty/config"
  [[ -f "$config" ]] || return
  local theme
  theme=$(awk -F= '/^[[:space:]]*theme[[:space:]]*=/ {gsub(/^[[:space:]]+|[[:space:]]+$/,"",$2); print $2; exit}' "$config")
  [[ -n "$theme" ]] || return
  local candidate theme_file
  for candidate in \
    "/Applications/Ghostty.app/Contents/Resources/ghostty/themes/${theme}" \
    "/usr/share/ghostty/themes/${theme}" \
    "/usr/local/share/ghostty/themes/${theme}"
  do
    [[ -f "$candidate" ]] && { theme_file="$candidate"; break; }
  done
  [[ -n "$theme_file" ]] || return
  local color
  color=$(awk -F= '/^[[:space:]]*selection-background[[:space:]]*=/ {gsub(/^[[:space:]]+|[[:space:]]+$|#/,"",$2); print $2; exit}' "$theme_file")
  [[ -n "$color" ]] || return
  zle_highlight=(paste:bg=#${color})
}
_paste_highlight_init
unfunction _paste_highlight_init

if [[ "$(uname)" == "Darwin" ]]; then
    HB_CNF_HANDLER="/opt/homebrew/Library/Homebrew/command-not-found/handler.sh"
    [ -f "$HB_CNF_HANDLER" ] && source "$HB_CNF_HANDLER"
else
    if [[ -r /usr/share/doc/pkgfile/command-not-found.zsh ]]; then
        source /usr/share/doc/pkgfile/command-not-found.zsh
    elif [[ -r /etc/zsh_command_not_found ]]; then
        source /etc/zsh_command_not_found
    fi
fi

# ─────────────────────────── Prompt ───────────────────────────
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' stagedstr ' %F{3}✚%f'
zstyle ':vcs_info:git:*' unstagedstr ' %F{1}✗%f'
zstyle ':vcs_info:git:*' formats ' %F{4}git:(%F{1}%b%F{4})%f%u%c'
zstyle ':vcs_info:git:*' actionformats ' %F{4}git:(%F{1}%b|%a%F{4})%f%u%c'
setopt PROMPT_SUBST
RPROMPT='%F{8}[%T]%f'
PROMPT='%(?:%F{2}➜:%F{1}➜)%f %F{6}%c%(#.#.)%f${vcs_info_msg_0_} '

# ─────────────────────────── Local overlay (optional) ───────────────────────────
# Machine-specific config registers itself here. Not part of this repo.
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
