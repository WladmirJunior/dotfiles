# ─────────────────────────── PATH ───────────────────────────
export PATH="$HOME/.local/bin:$PATH"
export PATH="$PATH:/usr/local/bin"

# Homebrew is not on the default PATH, so non-interactive and fresh login
# shells (mosh, ssh) lose every brew binary without this.
for __brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [ -x "$__brew" ]; then
    eval "$("$__brew" shellenv)"
    break
  fi
done
unset __brew

# Default terminal editor for CLI tools such as Yazi, Git, and crontab.
export EDITOR='nvim'
export VISUAL="$EDITOR"

# ─────────────────────────── Shortcuts ───────────────────────────
alias sr="source ~/.zshrc"
alias vsh="nvim ~/.zshrc"

# ─────────────────────────── Modern Unix Tools ───────────────────────────
alias v='nvim'
alias vi='nvim'
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --git --group-directories-first'
  alias ll='eza -l --icons --git --group-directories-first'
  alias la='eza -a --icons --git --group-directories-first'
  alias lt='eza --tree --icons'
else
  alias ll='ls -la'
  alias la='ls -A'
fi
# Keep classic cat/grep/find intact; use the modern tools by their own names
# (bat / rg / fd are installed and callable directly).
alias help='tldr'

# Let Yazi return its final directory to the current shell. The standalone
# `yazi` command remains available when directory switching is not desired.
y() {
    local tmp cwd yazi_status
    tmp="$(mktemp -t 'yazi-cwd.XXXXXX')" || return 1
    command yazi "$@" --cwd-file="$tmp"
    yazi_status=$?
    cwd="$(<"$tmp")"
    rm -f -- "$tmp"
    [[ -n "$cwd" && "$cwd" != "$PWD" ]] && builtin cd -- "$cwd"
    return "$yazi_status"
}

