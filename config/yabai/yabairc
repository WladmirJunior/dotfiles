#!/usr/bin/env sh
# Yabai configuration for macOS
# Pure tiling window management (bsp) without requiring SIP to be disabled.

# Layout configuration
yabai -m config layout                       bsp
yabai -m config top_padding                  6
yabai -m config bottom_padding               6
yabai -m config left_padding                 6
yabai -m config right_padding                6
yabai -m config window_gap                   6

# Split ratio and window placement
yabai -m config auto_balance                 on
yabai -m config split_ratio                  0.50
yabai -m config window_placement             second_child

# Mouse actions: alt + left-click drag to move; alt + right-click drag to resize
yabai -m config mouse_follows_focus          off
yabai -m config focus_follows_mouse          off
yabai -m config mouse_modifier               alt
yabai -m config mouse_action1                move
yabai -m config mouse_action2                resize
yabai -m config mouse_drop_action            swap

# Floating rules for dialogs, settings, preferences, and popups
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^System Preferences$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off
yabai -m rule --add app="^1Password$" manage=off
yabai -m rule --add app="^Finder$" title="(Copy|Move|Trash|General|Info)" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Software Update$" manage=off
yabai -m rule --add sub-role="^AXSystemDialog$" manage=off
yabai -m rule --add sub-role="^AXDialog$" manage=off

echo "yabai configuration loaded."
